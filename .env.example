# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=          # pick a voice in ElevenLabs, paste its Voice ID here

# --- Optional overrides (defaults are the demo-recommended models) ---
# LLM_MODEL=claude-sonnet-5              # swap to claude-haiku-4-5-20251001 if latency > 1.5s
# STT_MODEL=gpt-4o-transcribe
# TTS_MODEL=eleven_flash_v2_5
# HOST=localhost
# PORT=7860
